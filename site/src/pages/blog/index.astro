---
import { getCollection } from "astro:content";
import BlogShell from "../../layouts/BlogShell.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft || import.meta.env.DEV)).sort(
  (left, right) => right.data.publishedAt.valueOf() - left.data.publishedAt.valueOf(),
);
const dateFormatter = new Intl.DateTimeFormat("en", {
  dateStyle: "long",
  timeZone: "UTC",
});
---

<BlogShell
  title="Volt Blog"
  description="Engineering notes about Volt, coding agents, local-first infrastructure, and remote sessions over Iroh."
  canonicalPath="/blog/"
>
  <header class="blog-header">
    <p class="label">Volt Blog</p>
    <h1>Building Volt in the open.</h1>
    <p>Engineering notes about coding agents, local-first infrastructure, and remote sessions over Iroh.</p>
  </header>

  {
    posts.length > 0 ? (
      <ol class="post-list">
        {posts.map((post) => (
          <li class="post-row">
            <div>
              <div class="post-meta">
                <time datetime={post.data.publishedAt.toISOString()}>
                  {dateFormatter.format(post.data.publishedAt)}
                </time>
                <span aria-hidden="true">·</span>
                <span>{post.data.author}</span>
                {post.data.draft && <span class="draft-badge">Draft</span>}
              </div>
              <h2>
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </h2>
              <p>{post.data.description}</p>
            </div>
            {post.data.image && (
              <a class="post-thumb" href={`/blog/${post.id}/`} tabindex="-1" aria-hidden="true">
                <img src={post.data.image} alt="" width="1200" height="630" loading="lazy" />
              </a>
            )}
          </li>
        ))}
      </ol>
    ) : (
      <p class="empty-state">The first Volt engineering post is in progress.</p>
    )
  }
</BlogShell>
