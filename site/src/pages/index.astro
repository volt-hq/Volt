---
import { getCollection } from "astro:content";
import VoltCast from "../components/VoltCast.astro";
import "../styles/site.css";

const installUnix = "curl -fsSL https://volt-cli.dev/install.sh | sh";
const installWindows = "irm https://volt-cli.dev/install.ps1 | iex";
const title = "Volt — a coding agent from terminal to phone";
const description =
  "Volt is an open-source coding agent that runs on your machine, adapts to your workflow, and lets you continue the same live session from your phone.";
const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (left, right) => right.data.publishedAt.valueOf() - left.data.publishedAt.valueOf(),
);
const hasPublishedPosts = posts.length > 0;
const dateFormatter = new Intl.DateTimeFormat("en", { dateStyle: "long", timeZone: "UTC" });
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f5f0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://volt-cli.dev/" />
    <link rel="icon" href="/volt-icon.png" type="image/png" />
    <link rel="alternate" type="application/rss+xml" title="Volt Blog" href="/rss.xml" />
  </head>
  <body>
    <header class="site-nav">
      <a class="brand" href="/">
        <img src="/volt-mark.svg" width="64" height="100" alt="" />
        volt
      </a>
      <nav aria-label="Main navigation">
        {hasPublishedPosts && <a href="/blog/">Blog</a>}
        <a href="/docs/">Docs</a>
        <a href="/docs/quickstart/">Quickstart</a>
        <a href="https://github.com/volt-hq/Volt">GitHub</a>
      </nav>
    </header>

    <main class="site-main">
      <section class="hero">
        <p class="kicker">Open source · Public beta</p>
        <h1>Your coding agent,<br />from terminal to phone.</h1>
        <p class="lede">
          Volt keeps the agent runtime, credentials, and tools on your machine. Bring your
          preferred model, adapt the workflow with extensions, and continue the same live
          session from your iPhone when you step away.
        </p>
        <div class="install" id="install-box" data-unix={installUnix} data-windows={installWindows}>
          <span class="install-legend" id="install-label">Install · macOS / Linux</span>
          <code id="install-cmd">{installUnix}</code>
          <button id="copy-btn" type="button" aria-label="Copy install command">Copy</button>
        </div>
        <p class="install-alt">
          or <code>npm install -g --ignore-scripts @hansjm10/volt-coding-agent</code>
          &nbsp;·&nbsp; <span id="install-other-label">Windows</span>:{" "}
          <code id="install-other-cmd">{installWindows}</code>
        </p>
        <div class="cta">
          <a class="btn primary" href="/docs/quickstart/">Get started</a>
          <a class="btn" href="/docs/">Read the docs</a>
          <a class="btn" href="https://github.com/volt-hq/Volt">GitHub</a>
        </div>
      </section>

      <section class="section" aria-labelledby="product-title">
        <header class="section-head">
          <p class="label">The terminal</p>
          <h2 id="product-title">A terminal built for agents.</h2>
          <p>
            A responsive TUI with native Plan mode, subagents, configurable keybindings, themes,
            session branching, and compaction. Works in tmux, over SSH, even on Termux.
          </p>
        </header>
        <figure class="product">
          <img
            class="shot"
            src="/docs-images/interactive-mode.png"
            width="1964"
            height="2536"
            loading="lazy"
            decoding="async"
            alt="Volt terminal session in a sample project. Below the startup header, the user asks Volt to make a failing slugify test pass. Volt reads src/slugify.js, runs npm test and sees the failure, edits the file with an inline diff, reruns npm test successfully, and summarizes the fix. The editor and footer show the project path, git branch, session name, model, and context usage."
          />
          <figcaption class="margin-notes">
            <ol>
              <li>
                <h3>Every step stays in the transcript</h3>
                <p>
                  File reads, edits as inline diffs, and shell commands with their result. Long
                  output collapses; <kbd>ctrl+o</kbd> expands it.
                </p>
              </li>
              <li>
                <h3>The editor shows the mode</h3>
                <p>
                  Build mode works directly. Plan mode limits the agent to research and asks you to
                  approve the plan before it executes.
                </p>
              </li>
              <li>
                <h3>The footer keeps the context</h3>
                <p>Working directory, branch, session name, model, context use, and cost.</p>
              </li>
            </ol>
            <p class="shot-meta">A real session: Volt fixing a failing test in a sample project. Volt 0.2.1.</p>
          </figcaption>
        </figure>
      </section>

      <section class="section" id="phone" aria-labelledby="phone-title">
        <header class="section-head">
          <p class="label">Terminal to phone</p>
          <h2 id="phone-title">Start on your desk. Finish from anywhere.</h2>
          <p>
            Every conversation you open in <code>volt</code> runs in a background daemon on your
            computer. The terminal is one client and a paired iPhone is another; any number of them
            can attach to the same conversation at once. Iroh connects
            devices directly when possible and falls back to end-to-end encrypted relays.
          </p>
        </header>

        <VoltCast />

        <figure class="pair">
          <img
            class="shot phone"
            src="/docs-images/shared-session-phone.png"
            width="603"
            height="1311"
            loading="lazy"
            decoding="async"
            alt="Volt iOS app showing the conversation Discuss a Small Todo App in the volt workspace on branch fix/511-stale-default-models. The prompt Tell me about a small todo app, sent from the phone, is followed by the model's reply. The composer shows Build mode and the gpt-6-luna model."
          />
          <img
            class="shot"
            src="/docs-images/shared-session-terminal.png"
            width="1964"
            height="880"
            loading="lazy"
            decoding="async"
            alt="The same conversation open in the Volt terminal UI on the computer, showing the same prompt and reply. The footer shows the branch, session name, gpt-6-luna, and [phone 1], meaning one phone is attached."
          />
          <figcaption>
            One conversation in the Volt iOS app and in the terminal. The prompt came from the phone
            and ran on the computer; <code>[phone 1]</code> in the terminal footer shows the attached
            phone. Volt 0.2.1.
          </figcaption>
        </figure>

        <div class="setup">
          <div>
            <h3>Pair a phone</h3>
            <pre class="commands"><code><span class="prompt" aria-hidden="true">$ </span>volt daemon start
<span class="prompt" aria-hidden="true">$ </span>volt remote workspace add /path/to/project --name my-project
<span class="prompt" aria-hidden="true">$ </span>volt remote pair --workspace my-project</code></pre>
            <p>
              Or open <code>/remote</code> inside Volt. Scan the pairing QR code with the app once;
              later reconnects use the saved computer.
            </p>
            <p class="links">
              <a href="/docs/quickstart/#continue-from-your-iphone">Set up phone access →</a>
              <a href="/docs/usage/#remote-access-over-iroh-preview">How remote access works →</a>
            </p>
          </div>
          <ul class="notes">
            <li>The iPhone app is in App Store review.</li>
            <li>
              Phone access needs the npm install (Node.js 22.19 or newer) on macOS with Apple
              silicon, Linux, or Windows. Standalone executables work locally only.
            </li>
            <li>Keep the computer running and reachable while you're away.</li>
            <li>
              The managed relay and completion notifications are Volt Pro services; direct and
              self-hosted connections are separate.
            </li>
          </ul>
        </div>

        <details class="tour">
          <summary>Watch the 64-second tour</summary>
          <video
            controls
            playsinline
            preload="none"
            width="1920"
            height="1080"
            poster="/media/volt-showcase-poster.jpg"
            aria-label="Animated showcase: Volt plans and fixes a bug, and the conversation continues from an iPhone after the developer leaves the desk"
          >
            <source src="/media/volt-showcase.mp4" type="video/mp4" />
          </video>
          <p>A tour of Volt, from your terminal to your iPhone. Sound on.</p>
        </details>
      </section>

      <section class="section" aria-labelledby="more-title">
        <header class="section-head">
          <p class="label">Also in the box</p>
          <h2 id="more-title">Your model. Your tools. Your workflow.</h2>
        </header>
        <dl class="specs">
          <div>
            <dt><a href="/docs/providers/">Choose your model</a></dt>
            <dd>
              Sign in to a built-in provider with a subscription or API key, add endpoints that speak
              the OpenAI, Anthropic, or Google APIs, or connect anything else with an extension.
              Switch models from inside a session.
            </dd>
          </div>
          <div>
            <dt><a href="/docs/extensions/">Hackable by design</a></dt>
            <dd>
              Volt ships with powerful defaults and skips the bloat. Add what you need with skills,
              extensions, prompt templates, and installable Volt packages — or ask Volt to build them
              for you.
            </dd>
          </div>
          <div>
            <dt><a href="/docs/security/">Supply chain, taken seriously</a></dt>
            <dd>
              Exact-pinned dependencies, shrinkwrapped releases, installs with lifecycle scripts
              disabled, and documented containerization patterns when you want hard boundaries.
            </dd>
          </div>
          <div>
            <dt><a href="/docs/sdk/">Scriptable and embeddable</a></dt>
            <dd>
              Drive Volt programmatically with the SDK, RPC mode, or a JSON event stream. Build your
              own tools on the same runtime the CLI uses.
            </dd>
          </div>
        </dl>
      </section>

      {
        hasPublishedPosts && (
          <section class="section" aria-labelledby="writing-title">
            <header class="section-head split">
              <div>
                <p class="label">From the blog</p>
                <h2 id="writing-title">Notes from building Volt.</h2>
              </div>
              <a href="/blog/">All posts →</a>
            </header>
            <ol class="writing">
              {posts.slice(0, 2).map((post) => (
                <li>
                  <time datetime={post.data.publishedAt.toISOString()}>
                    {dateFormatter.format(post.data.publishedAt)}
                  </time>
                  <div>
                    <h3>
                      <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                    </h3>
                    <p>{post.data.description}</p>
                  </div>
                </li>
              ))}
            </ol>
          </section>
        )
      }
    </main>

    <footer class="site-footer">
      <p>
        Maintained and distributed by{" "}
        <a href="https://github.com/hansjm10">Jordan Hans</a>. Derived from{" "}
        <a href="https://github.com/earendil-works/pi">Mario Zechner's Pi project</a>{" "}
        under the MIT License. Built in the open at{" "}
        <a href="https://github.com/volt-hq/Volt">github.com/volt-hq/Volt</a>.
      </p>
      <nav aria-label="Footer navigation">
        {hasPublishedPosts && <a href="/blog/">Blog</a>}
        <a href="/docs/">Docs</a>
        <a href="/docs/security/">Security</a>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="https://github.com/volt-hq/Volt/blob/main/CONTRIBUTING.md">Contributing</a>
      </nav>
    </footer>

    <script>
      // Server-rendered default is macOS/Linux; swap to PowerShell on Windows hosts.
      const box = document.getElementById("install-box");
      const label = document.getElementById("install-label");
      const cmdEl = document.getElementById("install-cmd");
      const otherLabel = document.getElementById("install-other-label");
      const otherCmd = document.getElementById("install-other-cmd");
      const uaData = (navigator as Navigator & { userAgentData?: { platform?: string } }).userAgentData;
      const platform = uaData?.platform || navigator.platform || navigator.userAgent;
      if (/windows|win32|win64/i.test(platform) && box && label && cmdEl && otherLabel && otherCmd) {
        label.textContent = "Install · Windows";
        cmdEl.textContent = box.dataset.windows ?? "";
        otherLabel.textContent = "macOS / Linux";
        otherCmd.textContent = box.dataset.unix ?? "";
      }

      const btn = document.getElementById("copy-btn");
      btn?.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(cmdEl?.textContent ?? "");
          btn.textContent = "Copied";
        } catch {
          btn.textContent = "Select and copy";
        }
        setTimeout(() => (btn.textContent = "Copy"), 1500);
      });
    </script>

    <style>
      .hero {
        padding-block: 6rem 5.5rem;
      }

      .kicker {
        margin: 0 0 1.4rem;
        color: var(--muted);
        font-family: var(--font-mono);
        font-size: 0.78rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      h1 {
        margin: 0;
        font-size: clamp(2.6rem, 6.6vw, 4.75rem);
        font-weight: 700;
        line-height: 1.02;
        letter-spacing: -0.04em;
      }

      .lede {
        max-width: 38rem;
        margin: 1.6rem 0 2.6rem;
        color: var(--ink-soft);
        font-size: 1.15rem;
        line-height: 1.6;
      }

      /* Framed like the Volt TUI editor: a border with its legend set into the top edge. */
      .install {
        position: relative;
        display: flex;
        align-items: center;
        gap: 1rem;
        max-width: 44rem;
        padding: 1.1rem 0.6rem 0.9rem 1.1rem;
        border: 1.5px solid var(--violet);
        border-radius: 4px;
      }

      .install-legend {
        position: absolute;
        top: 0;
        left: 0.8rem;
        padding-inline: 0.35rem;
        background: var(--paper);
        color: var(--violet);
        font-family: var(--font-mono);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        line-height: 1;
        text-transform: uppercase;
        transform: translateY(-50%);
      }

      .install code {
        flex: 1;
        overflow-x: auto;
        color: var(--ink);
        font-size: 0.95rem;
        white-space: nowrap;
      }

      .install button {
        flex: none;
        padding: 0.3rem 0.75rem;
        border: 1px solid var(--rule-strong);
        border-radius: 4px;
        background: transparent;
        color: var(--ink-soft);
        font: inherit;
        font-size: 0.85rem;
        cursor: pointer;
      }

      .install button:hover {
        border-color: var(--violet);
        color: var(--violet);
      }

      .install-alt {
        max-width: 44rem;
        margin: 0.9rem 0 0;
        color: var(--muted);
        font-size: 0.82rem;
      }

      .install-alt code {
        color: var(--ink-soft);
      }

      .cta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.7rem;
        margin-top: 2.2rem;
      }

      .btn {
        display: inline-block;
        padding: 0.6rem 1.15rem;
        border: 1px solid var(--rule-strong);
        border-radius: 5px;
        color: var(--ink);
        font-size: 0.95rem;
        font-weight: 600;
      }

      .btn:hover {
        border-color: var(--ink);
        text-decoration: none;
      }

      .btn.primary {
        border-color: var(--ink);
        background: var(--ink);
        color: var(--paper);
      }

      .btn.primary:hover {
        border-color: var(--violet);
        background: var(--violet);
      }

      .section {
        padding-block: 5rem;
        border-top: 1px solid var(--rule);
      }

      .section-head {
        max-width: 42rem;
        margin-bottom: 3rem;
      }

      .section-head.split {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 1rem 2rem;
        max-width: none;
      }

      .section h2 {
        margin: 0;
        font-size: clamp(1.7rem, 3.4vw, 2.3rem);
        line-height: 1.12;
        letter-spacing: -0.03em;
      }

      .section-head p:not(.label) {
        margin: 1rem 0 0;
        color: var(--ink-soft);
        font-size: 1.05rem;
      }

      .section h3 {
        margin: 0;
        font-size: 1rem;
        line-height: 1.35;
      }

      main :not(pre) > code,
      kbd {
        padding: 0.1em 0.35em;
        border-radius: 3px;
        background: var(--paper-sunk);
        font-size: 0.88em;
      }

      .install code,
      .install-alt code {
        padding: 0;
        background: none;
      }

      .shot {
        display: block;
        width: 100%;
        height: auto;
        border-radius: 8px;
        background: var(--night);
      }

      .product {
        display: grid;
        grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
        gap: 3rem;
        align-items: start;
        margin: 0;
      }

      .margin-notes {
        position: sticky;
        top: 2rem;
      }

      .margin-notes ol {
        margin: 0;
        padding: 0;
        list-style: none;
        counter-reset: note;
      }

      .margin-notes li {
        padding-block: 1.1rem;
        border-top: 1px solid var(--rule);
        counter-increment: note;
      }

      .margin-notes li:first-child {
        padding-top: 0;
        border-top: 0;
      }

      .margin-notes h3::before {
        content: counter(note, decimal-leading-zero);
        margin-right: 0.6rem;
        color: var(--muted);
        font-family: var(--font-mono);
        font-size: 0.8rem;
        font-weight: 400;
      }

      .margin-notes p {
        margin: 0.35rem 0 0;
        color: var(--ink-soft);
        font-size: 0.93rem;
      }

      .shot-meta,
      .pair figcaption,
      .tour p {
        color: var(--muted);
        font-size: 0.85rem;
      }

      .margin-notes .shot-meta {
        margin-top: 1.2rem;
        padding-top: 1.1rem;
        border-top: 1px solid var(--rule);
      }

      .pair {
        display: grid;
        grid-template-columns: minmax(0, 46fr) minmax(0, 223fr);
        gap: 1.25rem;
        align-items: start;
        margin: 4.5rem 0 0;
      }

      .shot.phone {
        border-radius: 18px;
      }

      .pair figcaption {
        grid-column: 1 / -1;
        max-width: 46rem;
      }

      .setup {
        display: grid;
        grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
        gap: 3rem;
        margin-top: 3.5rem;
      }

      .setup h3 {
        margin-bottom: 0.9rem;
      }

      .commands {
        overflow-x: auto;
        margin: 0;
        padding: 1rem 1.2rem;
        border-radius: 6px;
        background: var(--night);
        color: var(--night-text);
        font-size: 0.88rem;
        line-height: 1.7;
      }

      .commands .prompt {
        color: #8d879a;
        user-select: none;
      }

      .setup p {
        margin: 1rem 0 0;
        color: var(--ink-soft);
        font-size: 0.95rem;
      }

      .setup .links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem 1.6rem;
        font-weight: 600;
      }

      .notes {
        margin: 0;
        padding: 0;
        list-style: none;
        color: var(--ink-soft);
        font-size: 0.9rem;
      }

      .notes li {
        padding-block: 0.7rem;
        border-top: 1px solid var(--rule);
      }

      .notes li:first-child {
        padding-top: 0;
        border-top: 0;
      }

      .tour {
        margin-top: 3rem;
      }

      .tour summary {
        width: fit-content;
        color: var(--violet);
        font-weight: 600;
        cursor: pointer;
      }

      .tour video {
        display: block;
        width: 100%;
        max-width: 52rem;
        height: auto;
        aspect-ratio: 16 / 9;
        margin-top: 1.2rem;
        border-radius: 8px;
        background: var(--night);
      }

      .tour p {
        margin: 0.6rem 0 0;
      }

      .specs {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0 3rem;
        margin: 0;
      }

      .specs div {
        padding-block: 1.3rem 1.6rem;
        border-top: 1px solid var(--rule);
      }

      .specs dt {
        font-weight: 650;
      }

      .specs dt a {
        color: var(--ink);
      }

      .specs dt a:hover {
        color: var(--violet);
      }

      .specs dd {
        margin: 0.4rem 0 0;
        color: var(--ink-soft);
        font-size: 0.95rem;
      }

      .section-head.split > a {
        flex: none;
        font-weight: 600;
      }

      .writing {
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .writing li {
        display: grid;
        grid-template-columns: 12rem minmax(0, 1fr);
        gap: 0.4rem 2rem;
        padding-block: 1.5rem;
        border-top: 1px solid var(--rule);
      }

      .writing time {
        padding-top: 0.25rem;
        color: var(--muted);
        font-family: var(--font-mono);
        font-size: 0.8rem;
      }

      .writing h3 {
        font-size: 1.35rem;
        letter-spacing: -0.02em;
      }

      .writing h3 a {
        color: var(--ink);
      }

      .writing h3 a:hover {
        color: var(--violet);
      }

      .writing p {
        max-width: 40rem;
        margin: 0.4rem 0 0;
        color: var(--ink-soft);
      }

      @media (max-width: 860px) {
        .product,
        .setup {
          grid-template-columns: minmax(0, 1fr);
        }

        .margin-notes {
          position: static;
        }

        .pair {
          grid-template-columns: minmax(0, 1fr);
        }

        .shot.phone {
          width: min(60%, 16rem);
        }

        .pair .shot:not(.phone) {
          grid-row: 1;
        }
      }

      @media (max-width: 600px) {
        .hero {
          padding-block: 3.5rem 3.5rem;
        }

        .install {
          flex-direction: column;
          align-items: stretch;
          gap: 0.7rem;
          padding-right: 1.1rem;
        }

        .install code {
          white-space: pre-wrap;
          overflow-wrap: anywhere;
        }

        .install button {
          align-self: flex-start;
        }

        .section {
          padding-block: 3.5rem;
        }

        .specs {
          grid-template-columns: minmax(0, 1fr);
        }

        .writing li {
          grid-template-columns: minmax(0, 1fr);
        }
      }
    </style>
  </body>
</html>
