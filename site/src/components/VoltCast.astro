<style>
  .cast {
    margin: 0;
  }

  .cast-zones,
  .cast-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .cast-zones {
    margin-bottom: 1.5rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cast-zones span {
    position: relative;
    margin-inline: 0.75rem;
    padding-bottom: 0.45rem;
    border-bottom: 1px solid var(--rule-strong);
    text-align: center;
  }

  .cast-zones span::before,
  .cast-zones span::after {
    content: "";
    position: absolute;
    top: 100%;
    width: 1px;
    height: 0.4rem;
    background: var(--rule-strong);
  }

  .cast-zones span::before {
    left: 0;
  }

  .cast-zones span::after {
    right: 0;
  }

  .zone-computer {
    grid-column: 1 / 3;
  }

  .cast-row {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cast-member svg {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 460 / 480;
  }

  .floor {
    stroke: var(--rule-strong);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .shadow {
    fill: var(--ink);
    opacity: 0.1;
  }

  .cast-member h3 {
    margin: 1.2rem 0 0.35rem;
    padding-inline: 0.75rem;
    font-size: 1rem;
    line-height: 1.3;
  }

  .cast-member p {
    margin: 0;
    padding-inline: 0.75rem;
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  @media (max-width: 760px) {
    .cast-zones {
      display: none;
    }

    .cast-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 2.5rem;
    }
  }

  @media (max-width: 420px) {
    .cast-row {
      grid-template-columns: minmax(0, 1fr);
    }

    .cast-member svg {
      max-width: 14rem;
    }
  }
</style>
